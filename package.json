{
  "name": "solid-starter-kit",
  "version": "1.0.0",
  "description": "Solid.js starter kit with common structure from pays.online and honey.id",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/pathscale/ui-starter-app"
  },
  "scripts": {
    "start": "rsbuild dev",
    "dev": "rsbuild dev",
    "build": "npm run typecheck && rsbuild build && bun run cleanup",
    "typecheck": "tsc --noEmit",
    "preview": "rsbuild preview",
    "cleanup": "bun run src/scripts/cleanup.js",
    "prepare": "husky",
    "lint": "biome check .",
    "format": "biome format . --write",
    "commit": "cz"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": [
      "biome check --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@iconify/tailwind4": "^1.0.6",
    "@pathscale/ui": "^2.11.9",
    "@solidjs/router": "2.0.0-next.19",
    "@solidjs/web": "2.0.0-rc.4",
    "clsx": "^2.1.1",
    "glob": "^11.0.3",
    "popmotion": "^11.0.5",
    "solid-js": "2.0.0-rc.4",
    "solid-layouts": "^0.2.1",
    "tailwind-merge": "^3.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@commitlint/cli": "^19.0.3",
    "@commitlint/config-conventional": "^19.0.3",
    "@commitlint/cz-commitlint": "^19.8.1",
    "@iconify-json/lucide": "^1.2.127",
    "@iconify-json/mdi": "^1.2.3",
    "@rsbuild/core": "^1.3.20",
    "@rsbuild/plugin-babel": "^1.0.5",
    "@rsbuild/plugin-solid": "^1.0.5",
    "@tailwindcss/postcss": "^4.1.7",
    "@types/node": "^22.15.17",
    "babel-preset-solid": "^2.0.0-rc.2",
    "commitizen": "^4.3.0",
    "cssnano": "^7.0.7",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "rsbuild-plugin-solid-layouts": "^0.2.1",
    "tailwindcss": "^4.0.7",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "babel-preset-solid": "^2.0.0-rc.2"
  }
}
